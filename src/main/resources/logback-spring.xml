<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Propiedades globales -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="APP_NAME" value="${spring.application.name:-accounts-service}"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Consola: para desarrollo y producción -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Archivo de logs general -->
    <appender name="FILE_GENERAL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Archivo de logs de errores -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Niveles de logging por paquete -->
    <logger name="com.yanki.accounts" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_GENERAL"/>
        <appender-ref ref="FILE_ERROR"/>
    </logger>

    <!-- Niveles de logging para dependencias -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="DEBUG"/>
    <logger name="org.springframework.kafka" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.mongodb" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="reactor" level="INFO"/>
    <logger name="org.springframework.data.redis" level="WARN"/>
    <logger name="com.netflix" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_GENERAL"/>
        <appender-ref ref="FILE_ERROR"/>
    </root>

    <!-- Perfil de desarrollo: DEBUG para com.yanki -->
    <springProfile name="dev">
        <logger name="com.yanki.accounts" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.kafka" level="DEBUG"/>
        <logger name="org.mongodb" level="DEBUG"/>
    </springProfile>

    <!-- Perfil de producción: INFO para com.yanki -->
    <springProfile name="prod">
        <logger name="com.yanki.accounts" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="org.mongodb" level="WARN"/>
    </springProfile>

    <!-- Perfil de testing: WARN para reducir ruido en tests -->
    <springProfile name="test">
        <logger name="com.yanki.accounts" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.mongodb" level="ERROR"/>
    </springProfile>

</configuration>
